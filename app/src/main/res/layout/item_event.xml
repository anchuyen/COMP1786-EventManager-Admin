<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout of ONE event card in the list (used by EventAdapter), based on the Stitch design:
    type + status labels, title, a light box with date and location,
    and a footer with the organiser's initials, name and number of attendees.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginTop="@dimen/spacing_medium"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- ===== Type + status labels ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEventType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_type_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Event.Badge"
                tools:backgroundTint="@color/brand_primary_container"
                tools:text="@string/type_workshop"
                tools:textColor="@color/type_workshop" />

            <TextView
                android:id="@+id/tvEventStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@drawable/bg_type_badge"
                android:drawablePadding="@dimen/spacing_tiny"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Event.Badge"
                app:drawableStartCompat="@drawable/bg_status_dot"
                tools:backgroundTint="@color/status_upcoming_container"
                tools:text="@string/status_upcoming"
                tools:textColor="@color/status_upcoming" />
        </LinearLayout>

        <!-- ===== Event name ===== -->
        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Event.ItemTitle"
            tools:text="Android Development Workshop" />

        <!-- ===== Date + location box ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_details_box"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <TextView
                android:id="@+id/tvEventDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Event.ItemDetail"
                android:textColor="@color/text_primary"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/brand_primary"
                tools:text="Fri, 20 Nov 2026" />

            <TextView
                android:id="@+id/tvEventLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:drawablePadding="@dimen/spacing_small"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Event.ItemDetail"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/brand_primary"
                tools:text="Greenwich Campus, Room 301" />
        </LinearLayout>

        <!-- ===== Organiser (initials + name) and attendees ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrganiserAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_avatar"
                android:textStyle="bold"
                tools:backgroundTint="@color/brand_primary_container"
                tools:text="DT"
                tools:textColor="@color/brand_primary" />

            <TextView
                android:id="@+id/tvEventOrganiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Event.ItemDetail"
                tools:text="Dr Tuan Nguyen" />

            <TextView
                android:id="@+id/tvEventAttendees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_tiny"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Event.ItemDetail"
                app:drawableStartCompat="@drawable/ic_people"
                app:drawableTint="@color/brand_secondary"
                tools:text="40 attendees" />
        </LinearLayout>
        <!-- ===== Coursework (c): total sessions of this event ===== -->
        <TextView
            android:id="@+id/tvSessionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_type_badge"
            android:backgroundTint="@color/brand_secondary_container"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textAppearance="@style/TextAppearance.Event.Badge"
            android:textColor="@color/brand_on_secondary_container"
            tools:text="3 sessions" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>